    {
      "name": "Providers",
      "item": [
        {
          "name": "POST /api/providers/twilio/voice/status",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authToken = pm.collectionVariables.get('twilioAuthToken') || pm.environment.get('twilioAuthToken') || '';",
                  "const requestUrl = pm.variables.replaceIn(pm.request.url.toString());",
                  "const values = {};",
                  "",
                  "if (pm.request.body && pm.request.body.urlencoded) {",
                  "  pm.request.body.urlencoded.each(function (item) {",
                  "    if (item.disabled) {",
                  "      return;",
                  "    }",
                  "    const key = item.key;",
                  "    const value = pm.variables.replaceIn(item.value || '');",
                  "    if (!values[key]) {",
                  "      values[key] = [];",
                  "    }",
                  "    values[key].push(value);",
                  "  });",
                  "}",
                  "",
                  "let data = requestUrl;",
                  "Object.keys(values).sort().forEach(function (key) {",
                  "  values[key].forEach(function (value) {",
                  "    data += key + value;",
                  "  });",
                  "});",
                  "",
                  "const signature = authToken ? CryptoJS.enc.Base64.stringify(CryptoJS.HmacSHA1(data, authToken)) : '';",
                  "pm.collectionVariables.set('twilioSignature', signature);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-Twilio-Signature",
                "value": "{{twilioSignature}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "CallSid",
                  "value": "{{twilioCallSid}}",
                  "type": "text"
                },
                {
                  "key": "CallStatus",
                  "value": "{{twilioCallStatus}}",
                  "type": "text"
                },
                {
                  "key": "AnsweredBy",
                  "value": "human",
                  "type": "text"
                },
                {
                  "key": "CallDuration",
                  "value": "32",
                  "type": "text"
                },
                {
                  "key": "ErrorCode",
                  "value": "",
                  "type": "text"
                },
                {
                  "key": "SipResponseCode",
                  "value": "200",
                  "type": "text"
                }
              ]
            },
            "url": "{{twilioVoiceStatusCallbackUrl}}",
            "description": "Simulates a Twilio voice status callback. The pre-request script computes `X-Twilio-Signature` from `twilioAuthToken`."
          }
        }
      ]
    }
