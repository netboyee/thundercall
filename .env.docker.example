# Copy this file to .env.docker before running docker compose.

# Required for the ingest service when you enable the "nwws" profile.
THUNDERCALL_NWWS_USERNAME=
THUNDERCALL_NWWS_PASSWORD=
THUNDERCALL_NWWS_JOIN_PASSWORD=
THUNDERCALL_NWWS_NICK=
THUNDERCALL_NWWS_PRODUCTS=SVR,FFW,TOR,WSW,TSU
THUNDERCALL_NWWS_LOG_FULL_MESSAGES=false
THUNDERCALL_NWWS_IDLE_TIMEOUT=5m

# Optional for the API service. Defaults target free public U.S. government APIs.
THUNDERCALL_GEOCODER_TIMEOUT=10s
THUNDERCALL_GEOCODER_USER_AGENT=thundercall/0.1
THUNDERCALL_CENSUS_BASE_URL=https://geocoding.geo.census.gov/geocoder
THUNDERCALL_CENSUS_BENCHMARK=Public_AR_Current
THUNDERCALL_CENSUS_VINTAGE=Current_Current
THUNDERCALL_WEATHERGOV_BASE_URL=https://api.weather.gov

# Optional for the worker service. Leave blank if you only want to test queueing.
THUNDERCALL_TWILIO_VOICE_LOG_ONLY=true
THUNDERCALL_TWILIO_VOICE_TO_OVERRIDE=
THUNDERCALL_TWILIO_VOICE_OVERRIDE_SINGLE_CALL=true
TWILIO_VOICE_URL=https://thundercall-2287.twil.io/welcome
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=
TWILIO_VOICE_STATUS_CALLBACK=
