/**
 * Main handler for the Twilio IVR.
 * This function plays the latest alert for the caller, records callback
 * feedback, or opts the caller out of future ThunderCall voice alerts.
 *
 * Expected API endpoints:
 * - GET /api/users/messages/last?phoneNumber=<10-digit-number>
 * - GET /api/users/voice/opt-out?phoneNumber=<10-digit-number>
 */
exports.handler = async (context, event, callback) => {
  console.log('--- ThunderCallIVR invoked ---');
  console.log('Event received:', event);

  const twiml = new Twilio.twiml.VoiceResponse();
  const city = event.FromCity;
  const normalizedPhone = normalizePhoneNumber(event.From);

  console.log(`Original call from: ${event.From || 'Unknown'} (City: ${city || 'Unknown'})`);
  console.log(`Normalized caller phone number: ${normalizedPhone || 'Unavailable'}`);

  const functionPath = context.TWILIO_IVR_URL || 'https://thundercall-2287.twil.io/ThunderCallIVR';
  const apiBaseUrl = (context.API_BASE_URL || 'https://api.thundercall.com').replace(/\/+$/, '');

  const greetingAudioUrl = 'https://thundercall-2287.twil.io/TCallGreeting.mp3';
  const mainMenuAudioUrl = 'https://thundercall-2287.twil.io/TCallMainMenu.mp3';
  const audioNoRecentUrl = 'https://thundercall-2287.twil.io/TCallNoRecent.mp3';
  const defaultAudioUrl = 'https://thundercall-2287.twil.io/DefaultThunderCall.mp3';
  const testMessage = 'this is a test of the thundercall alerting system. Reminder this is just a test.';

  const stationAudioByAccountId = {
    2: {
      WSW: 'https://thundercall-2287.twil.io/thundercall%20winter.mp3',
      FFW: 'https://thundercall-2287.twil.io/Thundercall%20flood.mp3',
      TOR: 'https://thundercall-2287.twil.io/Thundercall%20Tornado.mp3',
      SVR: 'https://thundercall-2287.twil.io/Thundercall%20Tstorm.mp3'
    },
    4: {
      WSW: 'https://thundercall-2287.twil.io/WinterKWTX.mp3',
      FFW: 'https://thundercall-2287.twil.io/FlashFloodKWTX.mp3',
      TOR: 'https://thundercall-2287.twil.io/TornadoKWTX.mp3',
      SVR: 'https://thundercall-2287.twil.io/SevereWeatherKWTX.mp3'
    },
    3: {
      WSW: 'https://thundercall-2287.twil.io/KTREWinterStormWarning.mp3',
      FFW: 'https://thundercall-2287.twil.io/KTREFloodWarning.mp3',
      TOR: 'https://thundercall-2287.twil.io/KTRETornadoWarning.mp3',
      SVR: 'https://thundercall-2287.twil.io/KTREThunderStormWarning.mp3'
    }
  };

  const genericAudioByType = {
    WSW: 'https://thundercall-2287.twil.io/GenericWinterStormWarning.mp3',
    FFW: 'https://thundercall-2287.twil.io/GenericFlashFlood.mp3',
    SVR: 'https://thundercall-2287.twil.io/GenericSevereStorm.mp3',
    TOR: 'https://thundercall-2287.twil.io/GenericTornado.mp3'
  };

  const presentMenu = () => {
    console.log('Presenting main menu.');

    const gather = twiml.gather({
      numDigits: 1,
      timeout: 10,
      action: functionPath
    });

    gather.play({ loop: 1 }, mainMenuAudioUrl);
    console.log(`Playing main menu audio: ${mainMenuAudioUrl}`);

    twiml.say('We did not receive any input. Goodbye.');
    twiml.hangup();
  };

  const playLatestAlert = async () => {
    if (!normalizedPhone) {
      throw new Error('Caller phone number could not be normalized.');
    }

    const apiUrl = `${apiBaseUrl}/api/users/messages/last?phoneNumber=${encodeURIComponent(normalizedPhone)}`;
    console.log(`Calling latest-message API: ${apiUrl}`);

    const response = await fetch(apiUrl);
    console.log(`Latest-message API response status: ${response.status}`);

    if (!response.ok) {
      const responseText = await response.text();
      throw new Error(`Latest-message API failed with status ${response.status}. Body: ${responseText}`);
    }

    const data = await response.json();
    console.log('Latest-message API response body:', data);

    if (!data.found) {
      twiml.play(audioNoRecentUrl);
      console.log(`No recent voice alert found. Playing: ${audioNoRecentUrl}`);
      presentMenu();
      return;
    }

    const accountId = Number(data.account_id);
    const audioType = String(data.type || '').trim().toUpperCase();
    const playback = resolvePlayback(stationAudioByAccountId, genericAudioByType, accountId, audioType, defaultAudioUrl);

    console.log(`Resolved playback for accountId=${accountId} audioType=${audioType}:`, playback);

    if (playback.sayTestMessage) {
      twiml.say(testMessage);
      console.log(`Speaking test message: "${testMessage}"`);
    } else {
      twiml.play(playback.audioUrl);
      console.log(`Playing alert audio: ${playback.audioUrl}`);
    }

    presentMenu();
  };

  const optOutCaller = async () => {
    if (!normalizedPhone) {
      throw new Error('Caller phone number could not be normalized.');
    }

    const apiUrl = `${apiBaseUrl}/api/users/voice/opt-out?phoneNumber=${encodeURIComponent(normalizedPhone)}`;
    console.log(`Calling voice opt-out API: ${apiUrl}`);

    const response = await fetch(apiUrl);
    console.log(`Voice opt-out API response status: ${response.status}`);

    const responseText = await response.text();
    console.log('Voice opt-out API response body:', responseText);

    if (!response.ok) {
      throw new Error(`Voice opt-out API failed with status ${response.status}. Body: ${responseText}`);
    }

    let data = {};
    try {
      data = responseText ? JSON.parse(responseText) : {};
    } catch (error) {
      console.warn('Voice opt-out API returned non-JSON body:', error);
    }

    if (data.found) {
      twiml.say('You have been removed from future ThunderCall voice calls. Goodbye.');
      console.log(`Voice opt-out succeeded for ${normalizedPhone}.`);
    } else {
      twiml.say('We could not find an active ThunderCall voice signup for this number. Goodbye.');
      console.log(`No active voice signup found for ${normalizedPhone}.`);
    }
    twiml.hangup();
  };

  if (event.Digits) {
    console.log(`Digit pressed: ${event.Digits}`);

    try {
      switch (event.Digits) {
        case '1':
          console.log('Case 1 selected: play latest alert.');
          await playLatestAlert();
          break;

        case '2':
          console.log('Case 2 selected: record a message.');
          twiml.play('https://thundercall-2287.twil.io/Option2.mp3');
          twiml.redirect('/handle-recording');
          break;

        case '3':
          console.log('Case 3 selected: opt out of future voice calls.');
          await optOutCaller();
          break;

        case '4':
          console.log('Case 4 selected: invalid option prompt.');
          twiml.say('Sorry, that was not a valid option. Please try again.');
          presentMenu();
          break;

        case '5':
          console.log('Case 5 selected: repeat options.');
          twiml.say('Repeating response options.');
          presentMenu();
          break;

        default:
          console.log(`Invalid digit selected: ${event.Digits}`);
          twiml.say('Sorry, that was not a valid option. Please try again.');
          presentMenu();
          break;
      }
    } catch (error) {
      console.error('Error while handling menu selection:', error);
      twiml.say('Sorry, we could not process your request at this time. Please try again later.');
      twiml.hangup();
    }
  } else {
    console.log('Initial call or prior gather timeout.');
    twiml.play({ loop: 1 }, greetingAudioUrl);
    console.log(`Playing greeting audio: ${greetingAudioUrl}`);
    presentMenu();
  }

  console.log('Returning TwiML response.');
  return callback(null, twiml);
};

function normalizePhoneNumber(value) {
  if (!value) {
    return '';
  }

  let digits = String(value).replace(/\D/g, '');
  if (digits.length === 11 && digits.startsWith('1')) {
    digits = digits.substring(1);
  }

  if (digits.length !== 10) {
    return '';
  }

  return digits;
}

function resolvePlayback(stationAudioByAccountId, genericAudioByType, accountId, audioType, defaultAudioUrl) {
  if (audioType === 'TEST') {
    return { sayTestMessage: true, audioUrl: '' };
  }

  const stationAudio = stationAudioByAccountId[accountId];
  if (stationAudio && stationAudio[audioType]) {
    return { sayTestMessage: false, audioUrl: stationAudio[audioType] };
  }

  if (genericAudioByType[audioType]) {
    return { sayTestMessage: false, audioUrl: genericAudioByType[audioType] };
  }

  return { sayTestMessage: false, audioUrl: defaultAudioUrl };
}
