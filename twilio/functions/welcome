exports.handler = function(context, event, callback) {
  const twiml = new Twilio.twiml.VoiceResponse();
  const accountId = Number(event.id);
  const audioType = String(event.audio || '').trim().toUpperCase();
  const testMessage = 'this is a test of the thundercall alerting system. Reminder this is just a test.';
  const defaultAudioUrl = 'https://thundercall-2287.twil.io/DefaultThunderCall.mp3';

  const stationAudioByAccountId = {
    2: {
      WSW: 'https://thundercall-2287.twil.io/thundercall%20winter.mp3',
      FFW: 'https://thundercall-2287.twil.io/Thundercall%20flood.mp3',
      TOR: 'https://thundercall-2287.twil.io/Thundercall%20Tornado.mp3',
      SVR: 'https://thundercall-2287.twil.io/Thundercall%20Tstorm.mp3'
    },
    4: {
      WSW: 'https://thundercall-2287.twil.io/WinterKWTX.mp3',
      FFW: 'https://thundercall-2287.twil.io/FlashFloodKWTX.mp3',
      TOR: 'https://thundercall-2287.twil.io/TornadoKWTX.mp3',
      SVR: 'https://thundercall-2287.twil.io/SevereWeatherKWTX.mp3'
    },
    3: {
      WSW: 'https://thundercall-2287.twil.io/KTREWinterStormWarning.mp3',
      FFW: 'https://thundercall-2287.twil.io/KTREFloodWarning.mp3',
      TOR: 'https://thundercall-2287.twil.io/KTRETornadoWarning.mp3',
      SVR: 'https://thundercall-2287.twil.io/KTREThunderStormWarning.mp3'
    }
  };

  const genericAudioByType = {
    WSW: 'https://thundercall-2287.twil.io/GenericWinterStormWarning.mp3',
    FFW: 'https://thundercall-2287.twil.io/GenericFlashFlood.mp3',
    SVR: 'https://thundercall-2287.twil.io/GenericSevereStorm.mp3',
    TOR: 'https://thundercall-2287.twil.io/GenericTornado.mp3'
  };

  const playback = resolvePlayback(stationAudioByAccountId, genericAudioByType, accountId, audioType, defaultAudioUrl);

  if (playback.sayTestMessage) {
    twiml.say(testMessage);
  } else {
    twiml.play(playback.audioUrl);
  }

  twiml.pause({ length: 1 });
  twiml.hangup();

  callback(null, twiml);
};

function resolvePlayback(stationAudioByAccountId, genericAudioByType, accountId, audioType, defaultAudioUrl) {
  if (audioType === 'TEST') {
    return { sayTestMessage: true, audioUrl: '' };
  }

  const stationAudio = stationAudioByAccountId[accountId];
  if (stationAudio && stationAudio[audioType]) {
    return { sayTestMessage: false, audioUrl: stationAudio[audioType] };
  }

  if (genericAudioByType[audioType]) {
    return { sayTestMessage: false, audioUrl: genericAudioByType[audioType] };
  }

  return { sayTestMessage: false, audioUrl: defaultAudioUrl };
}
